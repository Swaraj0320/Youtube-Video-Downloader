# Production example. Replace example.com values in Render's Environment settings.
# For ordinary local ./start.sh development, leave these unset (no .env file required).
TUBECLIP_ENV=production
ALLOWED_ORIGINS=https://app.example.com,https://your-frontend.vercel.app
# Exact API hosts only. Render's RENDER_EXTERNAL_HOSTNAME is automatically added.
ALLOWED_HOSTS=api.example.com
TUBECLIP_DATA_DIR=/tmp/tubeclip-data
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_ANALYSES=1
ANALYSIS_TTL_SECONDS=900
JOB_TTL_SECONDS=1800
FILE_RETENTION_SECONDS=900
JOB_TIMEOUT_SECONDS=240
MAX_MEDIA_DURATION_SECONDS=600
MAX_CLIP_SECONDS=120
MAX_SOURCE_MB=128
MAX_OUTPUT_MB=128
MAX_STORAGE_MB=384
MIN_FREE_MB=256
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_ANALYSES_PER_MINUTE=6
RATE_LIMIT_DOWNLOADS_PER_MINUTE=3
MAX_DOWNLOADS_PER_DAY=10
# PORT is provided by Render; Docker uses 10000 if it is absent.
